# Read by the existing Makefile as a variable assignment; no shell sourcing.
# The diagnostic controller supplies this value explicitly for owned captures.
DEFUSS_VM_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Optional installed defuss-qemu package used by guest acceptance runners.
DEFUSS_QEMU_PACKAGE=
# Browser harness defaults; use a fresh PROFILE for every retained run.
PROFILE=win98-local
HEADFUL=0
CDP_PORT=19223
PORT=18081
RUNTIME_DIR=runtime/current/x86_64
# Optional user-supplied installed Windows 98 raw disk.
WIN98_DISK=
